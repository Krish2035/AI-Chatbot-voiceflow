# Root .gitignore to protect all sensitive keys & build artifacts

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local

# Node modules
node_modules/
package-lock.json

# Builds & Dist
dist/
dist-ssr/
build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files & uploads
uploads/
tmp/
temp/

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
