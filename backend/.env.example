# Server Port (Render automatically sets PORT)
PORT=5000

# Frontend URL for CORS (Set to your Vercel URL, e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# ==========================================
# MULTI-KEY AI PROVIDER CONFIGURATION
# Provide 1 or multiple keys (comma-separated).
# The server automatically balances traffic, rotates keys,
# and fails over if rate limits (429) or errors occur.
# ==========================================

# Groq API Keys (Get from https://console.groq.com)
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_API_KEY=

# Hugging Face API Keys / Tokens (Get from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEYS=your_hf_key_1,your_hf_key_2
HUGGINGFACE_API_KEY=

# ==========================================
# DATABASE (Render Postgres, Neon, Supabase, or Local)
# ==========================================
# Option A: Full Connection String (Recommended on Render / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Option B: Discrete Parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=voiceflow_db
PGUSER=postgres
PGPASSWORD=postgres

# Default AI Model (Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
DEFAULT_MODEL=llama-3.3-70b-versatile
