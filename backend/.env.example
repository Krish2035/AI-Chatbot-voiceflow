# Server Port (Render / Docker / Load Balancer)
PORT=5000

# Frontend URL for CORS (Set to your domain, e.g. https://your-app.vercel.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ==========================================
# MULTI-KEY AI PROVIDER CONFIGURATION
# Provide 1 or multiple keys (comma-separated).
# ==========================================
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_API_KEY=

HUGGINGFACE_API_KEYS=your_hf_key_1,your_hf_key_2
HUGGINGFACE_API_KEY=

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
JWT_SECRET=replace_with_a_secure_jwt_random_secret_key_32_chars_or_more
JWT_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# ==========================================
# REDIS CACHE & BULLMQ (Redis 6+)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# DATABASE & READ REPLICAS (Drizzle ORM + PostgreSQL)
# ==========================================
# Primary (Write) Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=voiceflow_db
PGUSER=postgres
PGPASSWORD=postgres

# Read Replica Database (Optional - Route SELECT queries to read replicas)
PG_REPLICA_HOST=localhost
PG_REPLICA_PORT=5433
PG_REPLICA_DATABASE=voiceflow_db
PG_REPLICA_USER=postgres
PG_REPLICA_PASSWORD=postgres

# Or full connection strings:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# DATABASE_READ_REPLICA_URL=postgresql://user:password@replica-hostname:5432/dbname

# Default AI Model (Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
DEFAULT_MODEL=llama-3.3-70b-versatile
